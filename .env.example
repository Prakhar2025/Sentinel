# Abuse-Ring Sentinel configuration template.
# Copy to .env and adjust. NEVER commit the real .env file.

# API authentication (demo-scoped values; rotate for any shared deployment)
SENTINEL_API_KEY=change-me-standard-key
SENTINEL_ADMIN_API_KEY=change-me-admin-key

# AWS / Bedrock. Credentials come ONLY from the default AWS credential chain
# (aws CLI profile or environment). Do NOT put access keys in this file.
AWS_REGION=us-east-1

# Model routing (Bedrock model IDs; verified live 2026-08-22, docs/08 appendix)
EXTRACTION_MODEL=amazon.nova-lite-v1:0
EXPLANATION_MODEL=openai.gpt-oss-120b-1:0
FALLBACK1_EXPLANATION_MODEL=openai.gpt-oss-20b-1:0
FALLBACK2_EXPLANATION_MODEL=zai.glm-5

# LLM behavior
BEDROCK_TIMEOUT_SECONDS=5
